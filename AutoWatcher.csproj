<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="./local.props" Condition="Exists('./local.props')" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AutoWatcher</RootNamespace>
    <AssemblyName>AutoWatcher</AssemblyName>
    <Version>1.0.2</Version>

    <SteamRoot Condition="'$(SteamRoot)' == '' and '$(OS)' == 'Windows_NT' and Exists('D:/Steam')">D:/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == '' and '$(OS)' == 'Windows_NT'">$(MSBuildProgramFiles32)/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == ''">$(HOME)/.local/share/Steam</SteamRoot>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(SteamRoot)/steamapps/common/Slay the Spire 2</Sts2Dir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(OS)' == 'Windows_NT'">$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    <RitsuLibDir Condition="'$(RitsuLibDir)' == ''">$(SteamRoot)/steamapps/workshop/content/2868840/3747602295/lib/0.111.0</RitsuLibDir>

    <!-- 钉死的依赖。两者都从游戏 mods 目录读，不把别人的二进制放进本仓库。 -->
    <CombatSolverDir Condition="'$(CombatSolverDir)' == ''">$(Sts2Dir)/mods/CombatSolver</CombatSolverDir>
    <WatcherDir Condition="'$(WatcherDir)' == ''">$(Sts2Dir)/mods/Watcher</WatcherDir>

    <ModOutputDir>$(Sts2Dir)/mods/AutoWatcher</ModOutputDir>
    <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">true</CopyModOnBuild>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <!-- 求解器和游戏都要放开内部成员：适配层要注册进求解器的内部注册表。 -->
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="CombatSolver" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <!-- 观者也要放开：有几个 Power 把只在钩子里维护的状态放在私有字段上，而那些钩子求解器不分发，只能在这里补写。 -->
    <Publicize Include="Watcher" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="STS2-RitsuLib" HintPath="$(RitsuLibDir)/STS2-RitsuLib.dll" Private="false" />
    <Reference Include="CombatSolver" HintPath="$(CombatSolverDir)/CombatSolver.dll" Private="false" />
    <Reference Include="Watcher" HintPath="$(WatcherDir)/Watcher.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidatePinnedDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="找不到 $(Sts2DataDir)/sts2.dll。请检查 SteamRoot 或 local.props。" />
    <Error Condition="!Exists('$(RitsuLibDir)/STS2-RitsuLib.dll')" Text="找不到当前游戏版本的 RitsuLib。请检查 SteamRoot 或 local.props。" />
    <Error Condition="!Exists('$(CombatSolverDir)/CombatSolver.dll')" Text="找不到 $(CombatSolverDir)/CombatSolver.dll。请先构建并部署 CombatSolver。" />
    <Error Condition="!Exists('$(WatcherDir)/Watcher.dll')" Text="找不到 $(WatcherDir)/Watcher.dll。请把钉死的观者 mod 复制到游戏 mods 目录。" />
  </Target>

  <!--
    针对哪一份观者核对过，只在构建时提醒，不再让构建失败。
    以前这里是 Error：哈希一变就编译不过，逼着重新核对。开发期那是对的，但发布之后
    观者每次更新都会让所有想自己构建的人卡住，而运行期已经有结构自检兜底
    （src/AdapterSelfCheck.cs：低于版本下限或缺成员就干净地拒绝加载）。
    所以这里降成 Warning：告诉你"你正在对着一份没核对过的观者构建"，然后放你过去。
  -->
  <Target Name="VerifyWatcherHash" AfterTargets="ValidatePinnedDependencies">
    <GetFileHash Files="$(WatcherDir)/Watcher.dll" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="ActualWatcherHash" />
    </GetFileHash>
    <Warning Condition="'$(ActualWatcherHash.ToLowerInvariant())' != '$(VerifiedWatcherDllSha256)'"
             Text="正在对着一份没有逐条核对过的观者构建。核对过的是 $(VerifiedWatcherDllSha256)，实际是 $(ActualWatcherHash.ToLowerInvariant())。结构自检仍然会在加载时把关，但数值和语义的漂移它抓不到——换版本请重新核对每一个动词，并更新 src/PinnedTargets.cs。" />
  </Target>

  <PropertyGroup>
    <!-- 观者 v0.9.28 (Workshop 3747526116)。逐条核对是在 0.9.25 上做的，之后每版都是
         整体反编译 diff 后确认结论仍成立。0.9.27 → 0.9.28 有两处玩法改动（通晓万物、
         预见回收经纬）已经跟进，其余全是特效，见 src/PinnedTargets.cs 的注释 -->
    <VerifiedWatcherDllSha256>3262f52087cfbee9d0efd72e193aa6c3d9164b412f499d1c7b46ace0ac4311e5</VerifiedWatcherDllSha256>
  </PropertyGroup>

  <Target Name="CopyMod" AfterTargets="Build" Condition="'$(CopyModOnBuild)' == 'true'">
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/AutoWatcher.json" DestinationFolder="$(ModOutputDir)" />
  </Target>
</Project>
